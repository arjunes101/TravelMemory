<mxfile host="app.diagrams.net" modified="2026-10-06T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="travelmemory-architecture" name="TravelMemory Architecture"><mxGraphModel dx="1760" dy="590" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="590" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="TravelMemory deployment architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#17324d;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="45" as="geometry" /></mxCell><mxCell id="note" value="Mumbai region (ap-south-1) | Cloudflare optional and not used in this deployment" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#506273;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1200" height="30" as="geometry" /></mxCell><mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;br&gt;Travelers&lt;br&gt;Loads UI and&lt;br&gt;makes API calls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcecff;strokeColor=#4b6580;fontColor=#17324d;fontSize=18;" vertex="1" parent="1"><mxGeometry x="35" y="150" width="230" height="150" as="geometry" /></mxCell><mxCell id="fealb" value="&lt;b&gt;Frontend ALB&lt;/b&gt;&lt;br&gt;&lt;br&gt;Internet-facing&lt;br&gt;HTTP :80&lt;br&gt;frontend target group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcecff;strokeColor=#4b6580;fontColor=#17324d;fontSize=18;" vertex="1" parent="1"><mxGeometry x="355" y="150" width="245" height="150" as="geometry" /></mxCell><mxCell id="feec2" value="&lt;b&gt;Frontend EC2 x2&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nginx :80&lt;br&gt;React static build&lt;br&gt;frontend-master + frontend-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f4f0;strokeColor=#4b6580;fontColor=#17324d;fontSize=18;" vertex="1" parent="1"><mxGeometry x="690" y="150" width="270" height="150" as="geometry" /></mxCell><mxCell id="bealb" value="&lt;b&gt;Backend ALB&lt;/b&gt;&lt;br&gt;&lt;br&gt;Internet-facing&lt;br&gt;HTTP :80&lt;br&gt;backend target group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcecff;strokeColor=#4b6580;fontColor=#17324d;fontSize=18;" vertex="1" parent="1"><mxGeometry x="355" y="370" width="245" height="155" as="geometry" /></mxCell><mxCell id="beec2" value="&lt;b&gt;Backend EC2 x2&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nginx :80 to Node :3000&lt;br&gt;systemd keeps Node alive&lt;br&gt;backend-master + backend-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f4f0;strokeColor=#4b6580;fontColor=#17324d;fontSize=17;" vertex="1" parent="1"><mxGeometry x="690" y="370" width="270" height="155" as="geometry" /></mxCell><mxCell id="atlas" value="&lt;b&gt;MongoDB Atlas&lt;/b&gt;&lt;br&gt;&lt;br&gt;Managed database&lt;br&gt;travelmemory database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0c2;strokeColor=#4b6580;fontColor=#17324d;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1110" y="370" width="280" height="155" as="geometry" /></mxCell><mxCell id="e1" value="GET app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b6580;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="browser" target="fealb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="distribute" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b6580;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="fealb" target="feec2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="API requests from loaded app" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b6580;strokeWidth=2;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b6580;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="browser" target="bealb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="distribute" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b6580;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="bealb" target="beec2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="database queries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4b6580;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="beec2" target="atlas"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note2" value="Cloudflare may be placed before the frontend ALB if used. It was not configured in the evidence provided." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#506273;" vertex="1" parent="1"><mxGeometry x="1420" y="380" width="300" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>